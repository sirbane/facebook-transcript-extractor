# Set a strong random value before public deployment.
API_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-api-domain.example

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_VIDEO_SECONDS=3600
WHISPER_CACHE=/tmp/whisper-cache

API_BASE_URL=http://127.0.0.1:8000
MCP_HOST=0.0.0.0
MCP_PORT=8001
